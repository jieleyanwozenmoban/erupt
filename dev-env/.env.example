# Erupt Development Environment Configuration
# Copy this file to .env and modify as needed

# MySQL Configuration
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=erupt_dev
MYSQL_USER=erupt
MYSQL_PASSWORD=erupt123

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Admin Tools Ports (optional)
ADMINER_PORT=8080
REDIS_COMMANDER_PORT=8081

# Timezone
TZ=Asia/Shanghai

# Spring Boot Application Configuration (for reference)
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/erupt_dev?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=erupt
SPRING_DATASOURCE_PASSWORD=erupt123
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=redis123
